 template class AC_GAME_API ScriptRegistry<WorldScript>;
+
+void ScriptMgr::OnInstanceResetPeriod(uint32 mapId, uint32 difficulty, uint32& period)
+{
+    CALL_ENABLED_HOOKS(WorldScript, WORLDHOOK_ON_INSTANCE_RESET_PERIOD,
+        script->OnInstanceResetPeriod(mapId, difficulty, period));
+}
+
+void ScriptMgr::OnInstanceResetSchedule(uint32 mapId, uint32 difficulty, time_t& resetTime, bool loading)
+{
+    CALL_ENABLED_HOOKS(WorldScript, WORLDHOOK_ON_INSTANCE_RESET_SCHEDULE,
+        script->OnInstanceResetSchedule(mapId, difficulty, resetTime, loading));
+}
