# mod-progression v1
# Copy to your server's etc/modules/mod_progression.conf.
# Keep Expansion = 2 and MaxPlayerLevel = 80 in worldserver.conf.
# The module leaves the core maximum at 80 and enforces the progression cap
# through player hooks. It does not change expansion/race/class availability.

Progression.Enable = 1

# Allowed: 1..min(80, worldserver's original MaxPlayerLevel).
# Invalid values log an error and fall back to min(60, original MaxPlayerLevel).
# Suggested progression: 60 -> 70 -> 80.
# Stock Death Knights cannot exist below level 55. With a lower testing cap,
# they remain at level 55 but cannot gain XP or advance.
Progression.LevelCap = 60

Progression.AnnounceOnLogin = 1

# Dungeon Finder follows the realm progression cap while Expansion remains 2.
# Caps 1-60 are Classic, 61-70 are Burning Crusade, and 71-80 are Wrath.
Progression.LFG.Enable = 1

# Mark LFG entries from later expansions unavailable. The DBC expansion field
# on each dungeon/category is used; player level is not used for classification.
Progression.LFG.LockFutureDungeons = 1

# Rewrite the random category offered by the 3.3.5 client to the current phase
# using the same supported hook as mod-rdf-expansion. Random category entries
# remain selectable so, for example, the offered Random BC can queue Classic.
Progression.LFG.RestrictRandom = 1

# Lock future-expansion entries in the Specific Dungeons list.
Progression.LFG.RestrictSpecific = 1

# .progression cap changes the live value only. Edit this file to persist it.
# .reload config re-reads these values and discards any live command override.
# Applies equally to human and bot Player objects; no Playerbots dependency.

# Existing characters above the cap are preserved by default. Set this to 1 to
# normalize them when they log in. GMs may always use .progression clamp.
Progression.ClampExistingCharacters = 0

# Lower active and stored Hunter/Warlock pets with their owner and clear pet XP.
Progression.Clamp.Pets = 1
Progression.Clamp.ResetTalents = 1
Progression.Clamp.RemoveHighLevelSpells = 1
Progression.Clamp.UnequipHighLevelGear = 1
Progression.Clamp.MailOverflowGear = 1

# When equipment is removed, mail a lootable cache containing green replacements
# for the emptied slots. Replacements are selected from the world item templates
# by target level, class usability, slot, weapon type and useful class stats.
Progression.Clamp.StarterKit = 1
Progression.Clamp.StarterCacheEntry = 900100

# Overflow equipment is mailed by this existing world creature entry. The stock
# value is The Postmaster. SenderName is used for the letter's RP signature.
Progression.Mail.SenderEntry = 34337
Progression.Mail.SenderName = "Keepers of the Realm"
Progression.Mail.Subject = "The Call of an Earlier Age"
Progression.Mail.StarterSubject = "Equipment for the Earlier Age"
Progression.Mail.Body = "Adventurer,$B$BThe realm has been drawn back to an earlier age, and some of the equipment you carried belongs to battles yet to come.$B$BThese items have been returned to you for safekeeping. They are yours still, but their time has not yet arrived.$B$BWhen the realm advances, you may reclaim their full use.$B$BUntil then, steel yourself for the trials that lie before you.$B$B-- {sender}"
